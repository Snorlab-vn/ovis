+// Ovis patch: the picks are also written for Ovis, which shows them as chips under its composer:
+// $OVIS_STATE_DIR (else ~/.config/ovis)/next-prompts/<session id>.json, { session_id, at, picks }.
+// A failed write never stops the mod.
+async function publishPicks($: EngineInterface, picks: string[]) {
+  try {
+    const home = await $.env.get('HOME')
+    const state = (await $.env.get('OVIS_STATE_DIR')) || (home ? `${home}/.config/ovis` : '')
+    if (!state) return
+    const dir = `${state}/next-prompts`
+    const id = await $.session.id()
+    await $.process.run(['mkdir', '-p', dir])
+    await $.fs.write(`${dir}/${id}.json`, JSON.stringify({ session_id: id, at: Date.now(), picks }))
+  } catch {
+    // Ovis is optional
   }
 }
 
